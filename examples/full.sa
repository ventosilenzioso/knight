#include <knight>

system::config() {
    server.name = "Knight RP";
    server.max_players = 100;
    server.port = 7777;
    server.gamemode = "knight 1";
    server.language = "English";
    server.weather = 10;
    server.world_time = 12;
    server.gravity = 0.008;
    server.stream_distance = 300.0;
    server.announce = true;
};

system::start() {
    SetGameModeText("Knight RP v1");
    SetWorldTime(12);
    SetWeather(10);
    AddPlayerClass(0, 1958.4, 1343.2, 15.4, 270.0, 24, 50);
    AddPlayerClass(7, 1958.4, 1343.2, 15.4, 270.0, 24, 50);
    DisableInteriorEnterExits();
};

player::connect() {
    SendClientMessage(playerid, "Selamat datang, {PlayerName(playerid)}!");
    SetPlayerHealth(playerid, 100.0);
    SetPlayerArmour(playerid, 0.0);
    SetPlayerScore(playerid, 0);
};

player::spawn() {
    SetPlayerHealth(playerid, 100.0);
    SetPlayerArmour(playerid, 50.0);
    SendClientMessage(playerid, "Kamu spawn. Skor: {GetPlayerScore(playerid)}");
};

player::death(Player killer) {
    if (killer != null) {
        SendClientMessage(playerid, "Kamu dibunuh oleh {PlayerName(killer)}");
        GivePlayerMoney(killer, 100);
    } else {
        SendClientMessage(playerid, "Kamu mati.");
    }
};

player::chat(string message) {
    if (message == "hi") {
        SendClientMessage(playerid, "Halo juga!");
        return false;
    }
    return true;
};

player::command("/heal") {
    SetPlayerHealth(playerid, 100.0);
    SetPlayerArmour(playerid, 100.0);
    SendClientMessage(playerid, "Diheal.");
};

player::command("/pay", Player target, int amount) {
    if (target == null) {
        SendClientMessage(playerid, "Pemain tidak ditemukan.");
        return;
    }
    if (amount <= 0) {
        SendClientMessage(playerid, "Jumlah harus > 0.");
        return;
    }
    if (GetPlayerMoney(playerid) < amount) {
        SendClientMessage(playerid, "Uang tidak cukup.");
        return;
    }
    GivePlayerMoney(playerid, -(amount));
    GivePlayerMoney(target, amount);
    SendClientMessage(playerid, "Kamu membayar {amount} ke {PlayerName(target)}.");
    SendClientMessage(target, "Kamu menerima {amount} dari {PlayerName(playerid)}.");
};

player::command("/tp", float x, float y, float z) {
    SetPlayerPos(playerid, x, y, z);
    SendClientMessage(playerid, "Teleport ke {x}, {y}, {z}.");
};

player::command("/stats") {
    SendClientMessage(playerid, "Nama: {PlayerName(playerid)} | HP: {GetPlayerHealth(playerid)} | Uang: {GetPlayerMoney(playerid)} | Skor: {GetPlayerScore(playerid)}");
};

player::enter_vehicle(Vehicle car) {
    SendClientMessage(playerid, "Masuk kendaraan {car.model}.");
};

player::exit_vehicle(Vehicle car) {
    SendClientMessage(playerid, "Keluar kendaraan.");
};

vehicle::create(int model, float x, float y, float z) {
    return CreateVehicle(model, x, y, z, 0.0, 1, 1);
};

world::checkpoint(float x, float y, float z) {
    SendClientMessage(playerid, "Checkpoint tercapai di {x}, {y}, {z}.");
    DisablePlayerCheckpoint(playerid);
};

world::object_create(int model, float x, float y, float z) {
    return CreateObject(model, x, y, z, 0.0, 0.0, 0.0, 200.0);
};

let next_td = 0;
textdraw::create(int x, int y, string text) {
    let td = next_td;
    next_td = next_td + 1;
    TextDrawCreate(td, x, y, text);
    return td;
};

textdraw::click(TextDraw td) {
    SendClientMessage(playerid, "TextDraw diklik.");
};

dialog::response(int id, bool accepted, string input) {
    if (id == 100 && accepted) {
        SendClientMessage(playerid, "Input: {input}");
    }
};

timer::every(60s) {
    SendClientMessageToAll("Satu menit berlalu.");
};
