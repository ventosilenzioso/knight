#include <knight>

system::config() {
    server.name = "Knight RP";
    server.max_players = 100;
    server.port = 7777;
    server.gamemode = "knight 1";
    server.language = "English";
    server.weather = 10;
    server.world_time = 12;
    server.gravity = 0.008;
    server.stream_distance = 300.0;
    server.announce = true;
};

system::start() {
    server.set_gamemode_text("Knight RP v1");
    server.set_world_time(12);
    server.set_weather(10);
    player.add_class(0, 1958.4, 1343.2, 15.4, 270.0, 24, 50);
    player.add_class(7, 1958.4, 1343.2, 15.4, 270.0, 24, 50);
    sa.DisableInteriorEnterExits();
};

player::connect() {
    self.message("Selamat datang, {self.name}!");
    self.set_health(100.0);
    self.set_armour(0.0);
    self.send_score(0);
};

player::spawn() {
    self.set_health(100.0);
    self.set_armour(50.0);
    self.message("Kamu spawn. Skor: {self.score}");
};

player::death(Player killer) {
    if (killer != null) {
        self.message("Kamu dibunuh oleh {killer.name}");
        killer.money += 100;
    } else {
        self.message("Kamu mati.");
    }
};

player::chat(string message) {
    if (message == "hi") {
        self.message("Halo juga!");
        return false;
    }
    return true;
};

player::command("/heal") {
    self.set_health(100.0);
    self.set_armour(100.0);
    self.message("Diheal.");
};

player::command("/pay", Player target, int amount) {
    if (target == null) {
        self.message("Pemain tidak ditemukan.");
        return;
    }
    if (amount <= 0) {
        self.message("Jumlah harus > 0.");
        return;
    }
    if (self.money < amount) {
        self.message("Uang tidak cukup.");
        return;
    }
    self.money -= amount;
    target.money += amount;
    self.message("Kamu membayar {amount} ke {target.name}.");
    target.message("Kamu menerima {amount} dari {self.name}.");
};

player::command("/tp", float x, float y, float z) {
    self.set_position(x, y, z);
    self.message("Teleport ke {x}, {y}, {z}.");
};

player::command("/stats") {
    self.message("Nama: {self.name} | HP: {self.health} | Uang: {self.money} | Skor: {self.score}");
};

player::enter_vehicle(Vehicle car) {
    self.message("Masuk kendaraan {car.model}.");
};

player::exit_vehicle(Vehicle car) {
    self.message("Keluar kendaraan.");
};

vehicle::create(int model, float x, float y, float z) {
    let v = Vehicle.create(model, x, y, z, 0.0, 1, 1);
    return v;
};

world::checkpoint(float x, float y, float z) {
    self.message("Checkpoint tercapai di {x}, {y}, {z}.");
    self.disable_checkpoint();
};

world::object_create(int model, float x, float y, float z) {
    let obj = Object.create(model, x, y, z, 0.0, 0.0, 0.0, 200.0);
    return obj;
};

textdraw::create(int x, int y, string text) {
    let td = TextDraw.create(x, y, text);
    return td;
};

textdraw::click(TextDraw td) {
    self.message("TextDraw diklik.");
};

dialog::response(int id, bool accepted, string input) {
    if (id == 100 && accepted) {
        self.message("Input: {input}");
    }
};

timer::every(60s) {
    self.message("Satu menit berlalu.");
};
