// Demonstrates the Knight standard library (built-in functions).
system::start() {
    AddPlayerClass(0, 1958.4, 1343.2, 15.4, 270.0, 24, 50);
};

player::connect(int playerid) {
    let parts = split(PlayerName(playerid), "_");
    let label = join(parts, " ");
    SendClientMessage(playerid, "Welcome, {upper(label)}!");
    SendClientMessage(playerid, "name length={len(PlayerName(playerid))} roll={random(1,6)}");
};

player::command("/math", float a, float b) {
    SendClientMessage(playerid, "min={min(a,b)} max={max(a,b)} abs={abs(a-b)} pow={pow(a,2.0)}");
    SendClientMessage(playerid, "clamp={clamp(a,0.0,100.0)} sqrt={sqrt(abs(b))} round={round(a)}");
};

player::command("/str", string text) {
    SendClientMessage(playerid, "upper={upper(text)} trim={trim(text)} starts={starts_with(text, "a")}");
    SendClientMessage(playerid, "sub={substr(text,0,3)} replaced={replace(text," ","_")}");
};

player::command("/coll") {
    let arr = array();
    arr = push(arr, 10);
    arr = push(arr, 20);
    arr = push(arr, 30);
    SendClientMessage(playerid, "count={len(arr)} first={at(arr,0)} last={pop(arr)}");
    let m = map("score", 5);
    m["level"] = 3;
    SendClientMessage(playerid, "keys={join(keys(m), ",")} has={has(m,"score")}");
    SendClientMessage(playerid, "formatted={format("%s has %d", "CJ", 42)} dist={distance(0.0,0.0,0.0,3.0,4.0,0.0)}");
};
